        <mxCell id="diagram-title" value="场景 B：B 系统静默登录（Authorization Code + PKCE）" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="44" as="geometry"/></mxCell>
