# 后端配置模板：复制为 .env 后编辑；不要覆盖已有的真实 .env。
# 仓库根目录启动读 .env，backend/ 启动读 ../.env；请只保留一份。
# 部署 JAR 时，将 .env 放在执行 java -jar 时的工作目录。
# 本文件按 Java properties 格式读取，不写 export，不给值额外加引号。

# 以下地址是本机示例，运行前换成管理员提供的实际信息。
SSO_BASE_URL=http://localhost:19089/oauth2Server/oauth2
SSO_CLIENT_ID=demo_client_b
SSO_CLIENT_SECRET=replace_with_one_time_plaintext_secret

# 单 JAR 运行时的完整回调；必须等于 SSO 登记的系统地址 + 回调路径。
# Vite 双进程开发时使用 http://localhost:5173/api/auth/callback。
B_CALLBACK_URL=http://localhost:18085/api/auth/callback

# 保留原默认模式。普通单点登录改成 SSO_ONLY，并同步修改 SSO 客户端登记。
SSO_AUTH_MODE=PAGE_CONTROLLED

# 可选项（下面是默认值），HTTPS 部署时 COOKIE_SECURE=true。
# SERVER_PORT=18085
# COOKIE_SECURE=false
# SSO_CONNECT_TIMEOUT=2s
# SSO_READ_TIMEOUT=3s
