        <mxCell id="portal" value="Portal" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1360" y="95" width="230" height="65" as="geometry"/></mxCell>
        <mxCell id="b1" value="1　无 B 本地会话&lt;br&gt;生成 state + verifier&lt;br&gt;challenge=S256(verifier)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="35" y="215" width="230" height="105" as="geometry"/></mxCell>
        <mxCell id="b2" value="2　GET /sso/v1/authorize&lt;br&gt;client_id / redirect_uri&lt;br&gt;state / code_challenge" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="690" y="215" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="b3" value="3　校验 client、精确 redirect URI&lt;br&gt;来源 CIDR/传输策略、S256 参数" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="690" y="380" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="b4" value="SSO_SID&lt;br&gt;指向活动会话？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="690" y="545" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="b5" value="4A　签发一次性 code&lt;br&gt;TTL 90s，绑定 client / URI / PKCE" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontColor=#3b225f;" vertex="1" parent="1"><mxGeometry x="1025" y="535" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="b6" value="4B　按 state hash 独立计数&lt;br&gt;保存 pending TTL 10min&lt;br&gt;302 Portal 登录" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontColor=#3b225f;" vertex="1" parent="1"><mxGeometry x="1025" y="700" width="230" height="125" as="geometry"/></mxCell>
        <mxCell id="b7" value="5　Portal 完成既有登录&lt;br&gt;beginSession 消费 pending&lt;br&gt;返回 code + redirect" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1360" y="700" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="b8" value="6　B callback 校验 state&lt;br&gt;把 code + verifier 交给后端" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="35" y="865" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="b9" value="7　后端 HMAC 调用 /exchange&lt;br&gt;timestamp + nonce + body hash" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="355" y="865" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="b10" value="8　GETDEL code；校验绑定、PKCE、活动会话&lt;br&gt;原子登记 client" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="690" y="865" width="230" height="125" as="geometry"/></mxCell>
        <mxCell id="b11" value="9　返回 identity_assertion JWS&lt;br&gt;包含 nonce / iss / aud / exp" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1025" y="865" width="230" height="115" as="geometry"/></mxCell>
        <mxCell id="b12" value="10　固定公钥/指纹验证 kid 与签名&lt;br&gt;校验 claims 后创建 B 本地会话" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="355" y="1040" width="230" height="120" as="geometry"/></mxCell>
