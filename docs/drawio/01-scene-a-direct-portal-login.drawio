<mxfile host="app.diagrams.net" modified="2026-09-07T00:00:00.000Z" agent="OpenAI Codex" version="24.7.17" type="device">
  <diagram id="scene-a" name="场景 A">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="diagram-title" value="场景 A：Portal 直接登录并建立 SSO 会话" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1520" height="44" as="geometry"/></mxCell>
        <mxCell id="diagram-subtitle" value="登录入口和用户校验保持 Portal 原逻辑；SSO 只负责会话与单点跳转" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" y="1055" width="1520" height="24" as="geometry"/></mxCell>
        <mxCell id="browser" value="浏览器" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="45" y="105" width="230" height="65" as="geometry"/></mxCell>
        <mxCell id="portal" value="Portal（既有认证）" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="380" y="105" width="250" height="65" as="geometry"/></mxCell>
        <mxCell id="sso" value="SSO 内部接口" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="745" y="105" width="250" height="65" as="geometry"/></mxCell>
        <mxCell id="store" value="Redis / MySQL" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1110" y="105" width="250" height="65" as="geometry"/></mxCell>
        <mxCell id="a1" value="1　POST /sys/login&lt;br&gt;提交现有登录凭据" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="45" y="225" width="230" height="85" as="geometry"/></mxCell>
        <mxCell id="a2" value="2　沿用原登录校验&lt;br&gt;签发 Portal JWT" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="380" y="225" width="250" height="85" as="geometry"/></mxCell>
        <mxCell id="a3" value="3　恢复旧 SID&lt;br&gt;JWT hash 映射优先&lt;br&gt;否则 PORTAL_SSO_REF" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="380" y="360" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="a4" value="4　POST /internal/sessions&lt;br&gt;sub=sys_user.id&lt;br&gt;username / old_sid? / pending?" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="745" y="360" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="a5" value="5　校验 old_sid 的 subject&lt;br&gt;匹配则撤销旧会话并保留恢复索引" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="745" y="520" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="a6" value="6　原子创建新会话&lt;br&gt;检查 disabled barrier&lt;br&gt;SET session + ZADD subject sessions" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontColor=#3b225f;" vertex="1" parent="1"><mxGeometry x="1110" y="520" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="a7" value="7　pending? → GETDEL&lt;br&gt;生成一次性 code / redirect_url" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="745" y="685" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="a8" value="8　返回 sid / expires_at&lt;br&gt;以及可选 redirect_url" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="745" y="835" width="250" height="85" as="geometry"/></mxCell>
        <mxCell id="a9" value="9　写入 Cookie 与映射&lt;br&gt;SSO_SID Path=/sso/v1&lt;br&gt;PORTAL_SSO_REF Path=/" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="380" y="835" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="a10" value="10　Portal 登录成功&lt;br&gt;若有 ssoRedirect 则跳回接入方" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="45" y="835" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="degrade" value="异常降级（当前实现）&lt;br&gt;SSO beginSession 失败仅记录日志；Portal 本地登录仍成功。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=12;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="1110" y="360" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="loopback + X-INNER-TOKEN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2563eb;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Lua / transaction" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7e22ce;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell>
