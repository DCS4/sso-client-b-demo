        <mxCell id="stop" value="禁止路径&lt;br&gt;• /internal/** 不暴露到 Nginx&lt;br&gt;• 不使用 Nacos / Feign 发现&lt;br&gt;• 内部接口不走 B 的 HMAC 体系&lt;br&gt;• 不存在第二套远程 System 通道" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=12;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="465" y="590" width="300" height="175" as="geometry"/></mxCell>
