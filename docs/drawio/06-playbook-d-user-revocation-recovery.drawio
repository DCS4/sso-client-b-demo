        <mxCell id="e10" value="补建" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2563eb;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="recover" target="r7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1340" y="960"/><mxPoint x="1340" y="580"/></Array></mxGeometry></mxCell>
