# Java 编译产物 - 二进制文件
*.class binary
*.jar binary
*.war binary
*.ear binary

# 证书和密钥文件 - 二进制
*.jks binary
*.p12 binary
*.keystore binary

# 图片资源 - 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.cur binary
*.bmp binary
*.webp binary

# 字体文件 - 二进制
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
*.otf binary

# 文档和办公文件 - 二进制
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

# 压缩和归档文件 - 二进制
*.zip binary
*.gz binary
*.tar binary
*.rar binary
*.7z binary
*.bz2 binary

# 前端资源和数据文件 - 二进制
*.bcmap binary
*.map binary
*.meta binary

# ========== 文本文件（统一使用 LF）==========

# Java 源代码和配置
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Web 前端文件
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.less text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf

# 模板和数据文件
*.ftl text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Shell 脚本 - 必须 LF
*.sh text eol=lf

# Windows 脚本 - 保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
