# ============================================================================
# SSO V2 外部系统（B 系统）环境配置模板
# ============================================================================
# 使用方式：
# 1. 首次运行时复制本文件为 .env（Copy-Item .env.example .env），不要覆盖已有的真实 .env；
# 2. 仓库根目录启动读取 .env，backend/ 目录启动读取 ../.env，请只保留根目录一份；
# 3. 部署单 JAR 时，将 .env 放在执行 java -jar 所在的工作目录；
# 4. 本文件按 Java properties 格式解析（KEY=value），不要写 export，不要给值额外加引号。
# ============================================================================

# 1. SSO V2 公共协议接口前缀（由 SSO 管理员提供，指向 sac-sso 服务，非 Portal 前端登录页地址）
SSO_BASE_URL=http://localhost:19089/oauth2Server/oauth2

# 2. 客户端 ID（由 SSO 管理端创建客户端时分配，对应 sys_sso.client_id）
SSO_CLIENT_ID=demo_client_b

# 3. 客户端明文密钥（必填！由 SSO 管理端新增或重置密钥 rotateSecret 时一次性展示，仅保存在后端）
SSO_CLIENT_SECRET=replace_with_one_time_plaintext_secret

# 4. B 系统唯一固定回调地址（必须等于 SSO 管理端登记的 系统地址 sysAddress + 回调路径 callbackAddress）
#    - 单 JAR 运行模式使用：http://localhost:18085/api/auth/callback
#    - Vite 双进程开发模式使用：http://localhost:5173/api/auth/callback
#    - 全局退出（退出整个服务）时，后端会自动提取其同源根地址（如 http://localhost:18085/）作为 post_logout_redirect_uri
B_CALLBACK_URL=http://localhost:18085/api/auth/callback

# 5. 客户端认证模式（必须与 SSO 管理端客户端登记的模式保持一致）：
#    - PAGE_CONTROLLED：页面受控模式（服务端枚举值 0，按页面签发 Token 并由 SSO 校验页面权限）
#    - SSO_ONLY       ：普通单点登录模式（服务端枚举值 1，全系统共用一组 Token，仅由 SSO 校验身份）
SSO_AUTH_MODE=PAGE_CONTROLLED

# 6. 可选运行参数（以下为默认值，按需取消注释修改；生产环境启用 HTTPS 时请设 COOKIE_SECURE=true）
# SERVER_PORT=18085
# COOKIE_SECURE=false
# SSO_CONNECT_TIMEOUT=2s
# SSO_READ_TIMEOUT=3s
