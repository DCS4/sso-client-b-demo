        <mxCell id="diagram-subtitle" value="固定部署：Portal/System 与 SSO 同 IP、不同端口；复用 Portal 既有登录能力" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" y="955" width="1520" height="24" as="geometry"/></mxCell>
