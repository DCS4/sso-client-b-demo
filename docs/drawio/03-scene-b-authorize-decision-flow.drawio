  <diagram id="authorize-decision" name="Authorize 决策">
    <mxGraphModel dx="1250" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="diagram-title" value="/authorize 决策与拒绝路径" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1170" height="44" as="geometry"/></mxCell>
        <mxCell id="diagram-subtitle" value="所有错误分支先完成 redirect URI 信任判断；未验证地址绝不作为错误回跳目标" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" y="1405" width="1170" height="24" as="geometry"/></mxCell>
        <mxCell id="start" value="GET /sso/v1/authorize" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="455" y="90" width="300" height="65" as="geometry"/></mxCell>
        <mxCell id="d1" value="client 存在且 enabled？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="455" y="205" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="d2" value="redirect_uri 精确匹配&lt;br&gt;且满足 CIDR / 传输策略？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="455" y="370" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="d3" value="state 非空&lt;br&gt;且 PKCE=S256 参数完整？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="455" y="545" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="d4" value="SSO_SID 对应活动会话？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="455" y="720" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="code" value="签发 code（TTL 90s）&lt;br&gt;绑定 client_id / redirect_uri&lt;br&gt;subject / code_challenge" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontColor=#3b225f;" vertex="1" parent="1"><mxGeometry x="455" y="890" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="redirect" value="安全构造回调 URI&lt;br&gt;追加 code + 原 state" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="455" y="1065" width="300" height="95" as="geometry"/></mxCell>
        <mxCell id="done" value="302 到 B callback" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="455" y="1215" width="300" height="65" as="geometry"/></mxCell>
        <mxCell id="count" value="按 state hash 增加独立重试计数" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="85" y="875" width="285" height="90" as="geometry"/></mxCell>
        <mxCell id="d5" value="计数达到上限（3）？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="85" y="1020" width="285" height="105" as="geometry"/></mxCell>
        <mxCell id="pending" value="保存 pending（TTL 10min）&lt;br&gt;只存授权上下文，不混入计数" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontColor=#3b225f;" vertex="1" parent="1"><mxGeometry x="85" y="1180" width="285" height="105" as="geometry"/></mxCell>
