<mxfile host="app.diagrams.net" modified="2026-09-07T00:00:00.000Z" agent="OpenAI Codex" version="24.7.17" type="device">
  <diagram id="revocation" name="用户撤销恢复">
    <mxGraphModel dx="1750" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="diagram-title" value="用户禁用/删除：顺序事件、撤销屏障与恢复闭环" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1670" height="44" as="geometry"/></mxCell>
        <mxCell id="diagram-subtitle" value="禁用先封住新会话，再撤销旧会话；恢复服务以 subject 索引补齐 Outbox 通知，升级时回填旧索引" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" y="1245" width="1670" height="24" as="geometry"/></mxCell>
        <mxCell id="system" value="System 事务" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="25" y="95" width="250" height="65" as="geometry"/></mxCell>
        <mxCell id="scheduler" value="System Event Scheduler" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="360" y="95" width="250" height="65" as="geometry"/></mxCell>
        <mxCell id="sso" value="SSO" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="700" y="95" width="250" height="65" as="geometry"/></mxCell>
        <mxCell id="redis" value="Redis" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1040" y="95" width="250" height="65" as="geometry"/></mxCell>
        <mxCell id="outbox" value="MySQL Outbox / B" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1380" y="95" width="250" height="65" as="geometry"/></mxCell>
        <mxCell id="r1" value="1　禁用或删除用户&lt;br&gt;更新 sys_user" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="25" y="220" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="r2" value="2　同一数据库事务写 user_status_event&lt;br&gt;确保用户状态与事件一致提交" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontColor=#3b225f;" vertex="1" parent="1"><mxGeometry x="25" y="365" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="r3" value="3　按 subject 保序 claim&lt;br&gt;租约 30s，失败可重试" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="360" y="365" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="r4" value="4　POST /internal/users/{sub}/revoke&lt;br&gt;loopback + X-INNER-TOKEN" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="700" y="365" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="r5" value="5　先建立 disabled barrier&lt;br&gt;阻止并发 beginSession 新建会话" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontColor=#3b225f;" vertex="1" parent="1"><mxGeometry x="1040" y="365" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="r6" value="6　快照 subject 下所有 SID&lt;br&gt;逐个写 tombstone 与恢复索引&lt;br&gt;删除活动会话" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontColor=#3b225f;" vertex="1" parent="1"><mxGeometry x="1040" y="530" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="r7" value="7　为已登记 clients 写 logout outbox" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontColor=#3b225f;" vertex="1" parent="1"><mxGeometry x="1380" y="530" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="r8" value="Outbox 写入全部成功？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="1040" y="725" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="r9" value="清理本次 SID / subject 恢复索引&lt;br&gt;事件标记完成" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="700" y="900" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="recover" value="RevocationRecoveryService&lt;br&gt;每 10s 根据全局 subject 索引补建通知&lt;br&gt;升级回填完成后同样接管" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1040" y="900" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="notify" value="Outbox worker claim 30s&lt;br&gt;签名通知 B；jti 去重" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="1380" y="900" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="enable" value="后续 enable 事件（同 subject 保序）&lt;br&gt;移除 disabled barrier" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="360" y="1050" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="legacy-migration" value="升级兼容（仅首次）&lt;br&gt;SCAN 旧 sso:user-revocations:{sub}&lt;br&gt;完整扫描才写 marker；失败每 60s 重试" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=12;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="700" y="1050" width="250" height="105" as="geometry"/></mxCell>
        <mxCell id="guard" value="三层保护&lt;br&gt;① DB 事件不丢&lt;br&gt;② Redis 恢复索引不丢撤销事实&lt;br&gt;③ Outbox 通知可重试" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=12;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="25" y="760" width="250" height="145" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell>
