        <mxCell id="reject2" value="拒绝：redirect / 来源 / 传输不合法&lt;br&gt;不重定向" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="850" y="385" width="310" height="100" as="geometry"/></mxCell>
