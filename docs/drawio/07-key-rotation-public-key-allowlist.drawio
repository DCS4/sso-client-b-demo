<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-09-07T00:00:00.000Z" agent="OpenAI Codex" version="24.7.17" type="device">
  <diagram id="key-rotation" name="密钥轮换">
    <mxGraphModel dx="1450" dy="1310" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1310" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="diagram-title" value="签名密钥轮换与接入方公钥白名单" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1370" height="44" as="geometry"/></mxCell>
        <mxCell id="diagram-subtitle" value="先预发布并固定新公钥，再切换签名；旧 key 只在显式过渡窗口内保留" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" y="1265" width="1370" height="24" as="geometry"/></mxCell>
        <mxCell id="ops" value="SSO 运维" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="85" y="100" width="300" height="65" as="geometry"/></mxCell>
        <mxCell id="sso" value="SSO 服务" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="575" y="100" width="300" height="65" as="geometry"/></mxCell>
        <mxCell id="client" value="B 接入方" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1065" y="100" width="300" height="65" as="geometry"/></mxCell>
        <mxCell id="k1" value="1　离线生成未来 RSA 私钥 JWK&lt;br&gt;安全存放，权限 0600&lt;br&gt;记录 new kid 与公钥指纹" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="85" y="225" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="k2" value="2　配置 jwks-additional-kids[new]&lt;br&gt;=明确截止时间，滚动重启" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="575" y="225" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="k3" value="3　/.well-known/jwks.json&lt;br&gt;预发布 current + 未过期 additional 公钥" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="575" y="390" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="k4" value="4　通过独立可信渠道核对指纹&lt;br&gt;把 new kid 加入本地 allowlist" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1065" y="390" width="300" height="115" as="geometry"/></mxCell>
        <mxCell id="d1" value="所有 B 都已固定并验证 new kid？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="575" y="565" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="wait" value="暂停切换&lt;br&gt;继续使用旧 current kid" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=12;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="85" y="570" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="k5" value="5　设置 current-kid=new&lt;br&gt;旧 kid 放入 additional 并配置截止时间&lt;br&gt;滚动重启" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="575" y="735" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="k6" value="6　新 token 使用 new kid 签名&lt;br&gt;JWKS 同时暴露新旧公钥（过渡期）" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="575" y="925" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="k7" value="7　B 仅接受 allowlist 中的 kid&lt;br&gt;拒绝 JWKS 中未知或未固定的 key" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="1065" y="925" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="k8" value="8　截止时间后旧 kid 不再出现在 JWKS&lt;br&gt;确认无旧 token 后人工移除旧私钥" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="575" y="1095" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="manual" value="当前实现边界&lt;br&gt;• 无密钥管理 UI / CLI&lt;br&gt;• 轮换依赖配置与滚动重启&lt;br&gt;• additional kid 必须显式设置过期时间" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=12;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="85" y="925" width="300" height="150" as="geometry"/></mxCell>
        <mxCell id="trust" value="信任原则&lt;br&gt;JWKS 用于取公钥，不用于自动扩张信任；新 kid 必须先经带外指纹确认。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=12;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="1065" y="1095" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="k1" target="k2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="k2" target="k3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="k3" target="k4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="k4" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b85450;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="wait"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="继续预发布" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b45309;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="wait" target="k3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2e7d32;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="k5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="k5" target="k6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="k6" target="k7"><mxGeometry relative="1" as="geometry"/></mxCell>
