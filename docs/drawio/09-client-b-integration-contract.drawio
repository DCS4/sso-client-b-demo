<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-09-07T00:00:00.000Z" agent="OpenAI Codex" version="24.7.17" type="device">
  <diagram id="client-b-contract" name="B 系统接入契约">
    <mxGraphModel dx="1450" dy="1240" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="diagram-title" value="B 系统接入契约：登录、状态校验与登出" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1370" height="44" as="geometry"/></mxCell>
        <mxCell id="diagram-subtitle" value="浏览器只携带一次性 code；B 后端使用 HMAC 调用并验证 JWS；B 自建本地会话与权限" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" y="1200" width="1370" height="24" as="geometry"/></mxCell>

        <mxCell id="browser" value="浏览器 / B 前端" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="35" y="95" width="280" height="65" as="geometry"/></mxCell>
        <mxCell id="backend" value="B 后端" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="365" y="95" width="300" height="65" as="geometry"/></mxCell>
        <mxCell id="sso" value="SSO /sso/v1/**" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="735" y="95" width="300" height="65" as="geometry"/></mxCell>
        <mxCell id="local" value="B 本地会话 / 权限" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1105" y="95" width="300" height="65" as="geometry"/></mxCell>

        <mxCell id="boundary" value="接入边界　① B 不读取 SSO_SID　② SSO 不签发业务 Access / Refresh Token　③ identity_assertion 仅用于一次建会话　④ 角色、菜单与数据权限始终由 B 管理" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=12;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="35" y="185" width="1370" height="75" as="geometry"/></mxCell>

        <mxCell id="login-label" value="登录" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="35" y="275" width="100" height="24" as="geometry"/></mxCell>
        <mxCell id="l1" value="1　无本地会话&lt;br&gt;原子保存 state&lt;br&gt;生成 verifier / S256 challenge" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="35" y="310" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="l2" value="2　GET /authorize&lt;br&gt;client_id / 精确 redirect_uri&lt;br&gt;state / code_challenge" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="735" y="310" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="l3" value="3　callback&lt;br&gt;校验并原子消费 state&lt;br&gt;得到 code" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="35" y="475" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="l4" value="4　POST /exchange&lt;br&gt;HMAC：timestamp + nonce&lt;br&gt;raw body hash + verifier" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="365" y="475" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="l5" value="5　HMAC → GETDEL code&lt;br&gt;校验 client / URI / PKCE / 会话&lt;br&gt;登记 session-clients → 签发 JWS" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="735" y="465" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="l6" value="6　验证 identity_assertion&lt;br&gt;固定 RS256 + kid 指纹白名单&lt;br&gt;iss / aud / exp / request_nonce&lt;br&gt;建本地会话，绝对过期不晚于 SSO" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontColor=#3b2455;" vertex="1" parent="1"><mxGeometry x="1105" y="460" width="300" height="135" as="geometry"/></mxCell>

        <mxCell id="status-label" value="敏感操作前状态校验（按需）" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="35" y="635" width="260" height="24" as="geometry"/></mxCell>
        <mxCell id="s1" value="7　POST /session/status&lt;br&gt;HMAC + sid" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="365" y="675" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="s2" value="仅已登记该 SID 的 client&lt;br&gt;才可能获得 active=true&lt;br&gt;返回签名 session_status" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="735" y="665" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="s3" value="验证 JWS 与 request_nonce&lt;br&gt;active=false：终止敏感操作&lt;br&gt;并清理本地会话" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1105" y="665" width="300" height="110" as="geometry"/></mxCell>

        <mxCell id="logout-label" value="登出" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="35" y="810" width="100" height="24" as="geometry"/></mxCell>
        <mxCell id="a1" value="主动登出&lt;br&gt;先清 B 本地会话&lt;br&gt;取本地会话绑定的 sid" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1105" y="845" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="a2" value="POST /logout（HMAC）&lt;br&gt;sid + client_id&lt;br&gt;精确 post_logout_redirect_uri" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="365" y="845" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="a3" value="撤销 SID + 写恢复索引 / Outbox&lt;br&gt;返回一次性 logout_request&lt;br&gt;浏览器请求匹配 SID 才清 SSO Cookie" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="735" y="835" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="a4" value="GET /logout?request=…&lt;br&gt;消费一次性请求&lt;br&gt;清 Cookie 后回跳登记地址" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="35" y="845" width="280" height="100" as="geometry"/></mxCell>

        <mxCell id="p1" value="Outbox 异步 POST&lt;br&gt;logout_token JWS&lt;br&gt;同 jti 重试，客户端返回 204" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="735" y="1020" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="p2" value="被动登出校验&lt;br&gt;kid / iss / aud / iat / exp / sid&lt;br&gt;events 正确、不得有 nonce&lt;br&gt;jti SETNX 幂等" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontColor=#3b2455;" vertex="1" parent="1"><mxGeometry x="365" y="1005" width="300" height="135" as="geometry"/></mxCell>
        <mxCell id="p3" value="按 sid 清理本地会话&lt;br&gt;业务权限数据不删除" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1105" y="1020" width="300" height="105" as="geometry"/></mxCell>

        <mxCell id="e1" value="302" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="302 code + state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="885" y="445"/><mxPoint x="175" y="445"/></Array></mxGeometry></mxCell>
        <mxCell id="e3" value="后端回调" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="HMAC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2563eb;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l4" target="l5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="identity_assertion" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="l5" target="l6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="HMAC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2563eb;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="session_status JWS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="sid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1255" y="805"/><mxPoint x="515" y="805"/></Array></mxGeometry></mxCell>
        <mxCell id="e9" value="HMAC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2563eb;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="logout_request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="885" y="980"/><mxPoint x="175" y="980"/></Array></mxGeometry></mxCell>
        <mxCell id="e11" value="logout_token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b85450;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="验证通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#64748b;fontSize=11;fontColor=#334155;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="515" y="1170"/><mxPoint x="1255" y="1170"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
