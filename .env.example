# 复制为 .env 后填入真实值。后端通过 spring.config.import 读取它。
#
# 查找位置相对进程工作目录：仓库根目录启动读 .env，backend/ 目录启动读 ../.env。
# 部署时把 .env 放在启动 jar 的目录下。

# 必填：application.properties / application.yml 用 ${SSO_CLIENT_SECRET:} 引用此键，
# 明文密钥只交付一次，只能留在后端，绝不能进入 Vue 代码或浏览器响应。
SSO_CLIENT_SECRET=replace_with_one_time_plaintext_secret

# 选填覆盖：写 Spring 属性名即可覆盖同名的默认值，不需要取消注释配置模板。
# sso.base-url=http://SSO-IP:19089/oauth2Server/oauth2
# sso.client-id=client_replace_me
# sso.callback-url=http://B-IP:18085/api/auth/callback
# sso.auth-mode=PAGE_CONTROLLED
# server.port=18085
# server.servlet.session.cookie.secure=false
