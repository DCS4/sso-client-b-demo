  <diagram id="scene-c" name="场景 C">
    <mxGraphModel dx="1750" dy="1280" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1280" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="diagram-title" value="场景 C：全局登出、恢复索引与 Outbox 通知" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1670" height="44" as="geometry"/></mxCell>
        <mxCell id="diagram-subtitle" value="登出先落“已撤销”事实，再异步通知；浏览器 Cookie 清理使用一次性 logout_request" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" y="1235" width="1670" height="24" as="geometry"/></mxCell>
        <mxCell id="browser" value="浏览器" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="25" y="95" width="230" height="65" as="geometry"/></mxCell>
        <mxCell id="caller" value="Portal / 发起登出的 B" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="350" y="95" width="250" height="65" as="geometry"/></mxCell>
        <mxCell id="sso" value="SSO" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="700" y="95" width="250" height="65" as="geometry"/></mxCell>
        <mxCell id="store" value="Redis / MySQL" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1050" y="95" width="250" height="65" as="geometry"/></mxCell>
        <mxCell id="clients" value="已登记的其他 B" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#1e293b;" vertex="1" parent="1"><mxGeometry x="1400" y="95" width="250" height="65" as="geometry"/></mxCell>
        <mxCell id="c1" value="1　用户发起退出&lt;br&gt;携带当前本地会话 / SID" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="25" y="215" width="230" height="95" as="geometry"/></mxCell>
        <mxCell id="c2" value="2　Portal：内部 logout&lt;br&gt;B：HMAC logout&lt;br&gt;精确校验 post_logout_redirect_uri" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="350" y="215" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="c3" value="3　校验调用方是否拥有 SID&lt;br&gt;解析 subject 与已登记 clients" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="700" y="215" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="c4" value="4　Redis Lua 原子撤销&lt;br&gt;写 tombstone + 全局/subject 恢复索引&lt;br&gt;删除 session 与 client 登记" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontColor=#3b225f;" vertex="1" parent="1"><mxGeometry x="1050" y="215" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="c5" value="5　为目标 client 写 MySQL outbox&lt;br&gt;同一 jti 可重复签名发送" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontColor=#3b225f;" vertex="1" parent="1"><mxGeometry x="1050" y="420" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="c6" value="6　创建 browser logout_request&lt;br&gt;TTL 30s；绑定 SID 与可信回跳" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="700" y="420" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="c7" value="7　浏览器 GET logout_request&lt;br&gt;服务端 GETDEL" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="25" y="585" width="230" height="105" as="geometry"/></mxCell>
        <mxCell id="c8" value="Cookie SID 与请求 SID 相同？" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;spacing=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="700" y="585" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="clear" value="清除 SSO_SID&lt;br&gt;跳回精确校验后的地址" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="350" y="760" width="250" height="95" as="geometry"/></mxCell>
        <mxCell id="keep" value="不清除较新的 Cookie&lt;br&gt;仍只跳回可信地址" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=12;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="700" y="760" width="250" height="95" as="geometry"/></mxCell>
        <mxCell id="claim" value="8　Outbox worker claim 30s&lt;br&gt;失败可重试；恢复服务每 10s 扫描索引" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1050" y="585" width="250" height="125" as="geometry"/></mxCell>
        <mxCell id="notify" value="9　签名 logout_token&lt;br&gt;回调 client 的 back-channel endpoint" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#7c2d12;" vertex="1" parent="1"><mxGeometry x="1400" y="585" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="local" value="10　client 验签、校验 claims&lt;br&gt;按 jti 去重并清理本地会话" style="ellipse;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="1400" y="760" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="failure" value="Outbox 插入失败时&lt;br&gt;撤销事实仍由 Redis tombstone / 恢复索引保留；恢复服务补建通知。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=12;spacing=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="1050" y="920" width="250" height="125" as="geometry"/></mxCell>
        <mxCell id="expiry" value="安全上限&lt;br&gt;B 本地会话有效期不得超过 SSO 全局会话有效期。" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=12;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1400" y="920" width="250" height="105" as="geometry"/></mxCell>
