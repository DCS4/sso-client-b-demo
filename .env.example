# 示例文件不包含真实凭证；复制到受控环境后由进程管理器注入。
SSO_BASE_URL=http://SSO-IP:10089/oauth2Server/oauth2
SSO_CLIENT_ID=client_replace_me
SSO_CLIENT_SECRET=replace_with_one_time_plaintext_secret
B_CALLBACK_URL=http://B-IP:18080/api/auth/callback
SSO_AUTH_MODE=PAGE_CONTROLLED
COOKIE_SECURE=false
SSO_CONNECT_TIMEOUT=2s
SSO_READ_TIMEOUT=3s
